APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=
JWT_AUDIENCE=
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
DATABASE_URL=postgresql+asyncpg://taskflow_dev:taskflow_dev_only@localhost:5433/taskflow_dev
TEST_DATABASE_URL=postgresql+asyncpg://taskflow_dev:taskflow_dev_only@localhost:5433/taskflow_test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
