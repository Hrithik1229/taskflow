# ── Never copy secrets or local configuration ──────────────────────────────
.env
.env.*
!.env.example

# ── Python noise ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/

# ── Dev / test artefacts ─────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.log
tests/

# ── Dev requirements (not needed in image) ──────────────────────────────────
requirements-dev.txt

# ── IDE / OS noise ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Docker files themselves (no recursion needed) ───────────────────────────
Dockerfile
.dockerignore
docker-compose*.yml
# Note: entrypoint.sh and migrate.sh are intentionally included (not excluded)
