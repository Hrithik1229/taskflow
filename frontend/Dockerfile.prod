# ============================================================
# Frontend production Dockerfile
# Multi-stage: build with Node 22, serve with Nginx
# ============================================================

# Stage 1: build
FROM node:22-slim AS builder

WORKDIR /app

# Copy lockfile first for cache efficiency
COPY package.json package-lock.json* pnpm-lock.yaml* ./
RUN npm ci --ignore-scripts

# Copy source selectively (exclude node_modules, dist, etc.)
COPY public/ ./public/
COPY src/ ./src/
COPY index.html ./
COPY vite.config.js ./
COPY eslint.config.js* ./
COPY .prettierrc* ./

# Build-time env vars are baked into the JS bundle at build time.
# Provide them via --build-arg or as ARGs here.
# In production these point to your deployed backend.
ARG VITE_API_BASE_URL=http://localhost:8000
ARG VITE_SOCKET_URL=http://localhost:8000

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_SOCKET_URL=${VITE_SOCKET_URL}

RUN npm run build

# Stage 2: serve with nginx
FROM nginx:1.27-alpine AS runtime

# Remove default config, copy our SPA config
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
